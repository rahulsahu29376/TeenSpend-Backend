# ==============================================================================
# TeenSpend Backend Environment Variables
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase Credentials (from Supabase Project Settings -> API)
# WARNING: Keep SUPABASE_SERVICE_ROLE_KEY strictly on the backend!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Authentication
JWT_SECRET=super_secret_jwt_key_teenspend_min_32_characters_random
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
